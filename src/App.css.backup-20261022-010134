
:root {
  --bg: #0b1020;
  --panel: #121a2d;
  --line: #253049;
  --text: #edf2ff;
  --muted: #8c9ab5;
  --green: #52e2a4;
}

* { box-sizing: border-box; }

body { margin: 0; }

button { font: inherit; cursor: pointer; }

.app-shell {
  min-height: 100vh;
  display: flex;
  color: var(--text);
  background: radial-gradient(ellipse at top, #182340, var(--bg) 55%);
}

.sidebar {
  width: 235px;
  flex-shrink: 0;
  padding: 25px 15px;
  border-right: 1px solid var(--line);
  background: #0a1020;
  display: flex;
  flex-direction: column;
}

.brand { display: flex; align-items: center; gap: 11px; padding: 0 8px 38px; }
.brand-logo {
  width: 42px; height: 42px; display: grid; place-items: center;
  color: #071a16; background: var(--green); border-radius: 12px;
}
.brand h2 { font-size: 18px; margin: 0; }
.brand h2 span { color: var(--green); }
.brand small { display: block; margin-top: 4px; font-size: 9px; letter-spacing: 1.5px; color: var(--muted); }

.nav-heading, .eyebrow {
  color: #8391af; font-size: 10px; font-weight: 700; letter-spacing: 1.4px;
}
.nav-heading { padding-left: 10px; margin-bottom: 12px; }
.sidebar nav { display: grid; gap: 7px; }

.nav-button {
  border: 1px solid transparent; background: transparent; color: #a0acc4;
  display: flex; align-items: center; gap: 11px; padding: 12px;
  border-radius: 9px; text-align: left; font-size: 12px;
}
.nav-button.selected { background: #17332f; border-color: #285448; color: var(--green); }
.nav-button:hover { background: #19233a; }
.count { margin-left: auto; font-size: 10px; }

.sidebar-bottom {
  margin-top: auto; display: flex; gap: 10px; align-items: center;
  padding: 13px 9px; border: 1px solid var(--line); border-radius: 10px;
  color: var(--green); font-size: 12px;
}
.sidebar-bottom small { display: block; margin-top: 4px; color: var(--muted); font-size: 10px; }

.main { flex: 1; min-width: 0; max-width: 1500px; margin: auto; padding: 28px 32px; }
.topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 25px; }
.topbar h1 { font-size: 25px; margin: 7px 0 0; letter-spacing: -.7px; }
.eyebrow { margin: 0; }
.connection { display: flex; align-items: center; gap: 8px; color: #abb6cc; font-size: 11px; }
.avatar { width: 34px; height: 34px; display: grid; place-items: center; margin-left: 10px; border-radius: 50%; background: #263654; font-size: 11px; }

.dot { width: 7px; height: 7px; display: inline-block; border-radius: 50%; flex-shrink: 0; }
.dot.green { background: #52e2a4; }
.dot.red { background: #ff7788; }

.notice { margin-bottom: 15px; padding: 12px; background: #16372e; border: 1px solid #285b48; border-radius: 8px; font-size: 12px; color: #a4f3ce; }

.metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; margin-bottom: 17px; }
.metric, .panel {
  background: linear-gradient(145deg, #141d32, #101729);
  border: 1px solid var(--line); border-radius: 13px;
}
.metric { padding: 17px; min-width: 0; }
.metric-icon { width: 35px; height: 35px; display: grid; place-items: center; color: var(--green); background: #1b382f; border-radius: 9px; margin-bottom: 14px; }
.metric small { color: #8c9ab5; font-size: 9px; letter-spacing: 1px; font-weight: 700; }
.metric h2 { font-size: 20px; margin: 9px 0 5px; overflow-wrap: anywhere; }
.metric p { color: var(--muted); font-size: 10px; margin: 0; }

.panel { padding: 20px; margin-bottom: 17px; }
.section-title { margin: 6px 0 17px; font-size: 17px; letter-spacing: -.3px; }
.section-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; }

.camera-frame {
  position: relative; height: clamp(220px, 31vw, 390px); overflow: hidden;
  display: grid; place-items: center; border: 1px solid #2b3650;
  border-radius: 10px; background: #070c17;
}
.camera-frame img { width: 100%; height: 100%; object-fit: contain; }
.camera-placeholder { display: flex; flex-direction: column; align-items: center; gap: 12px; color: var(--muted); text-align: center; }
.camera-placeholder b { color: #dce4f5; font-size: 13px; }
.camera-placeholder span { font-size: 11px; }
.live-label { position: absolute; top: 12px; left: 12px; display: flex; align-items: center; gap: 7px; background: #101729e8; padding: 7px 9px; border-radius: 5px; font-size: 9px; font-weight: 800; }
.camera-warning { position: absolute; bottom: 10px; left: 10px; right: 10px; padding: 10px; border-radius: 7px; background: #392c1c; color: #ffd28b; font-size: 11px; }

.camera-info { display: flex; gap: 18px; flex-wrap: wrap; padding: 13px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 10px; }
.camera-info span { display: flex; align-items: center; gap: 7px; }
.controls { display: flex; justify-content: space-between; align-items: center; gap: 15px; padding-top: 17px; }
.controls b { font-size: 12px; }
.muted, .controls p { color: var(--muted); font-size: 11px; line-height: 1.6; }
.controls p { margin: 5px 0 0; }

.primary, .stop {
  border: 0; border-radius: 8px; padding: 11px 14px; display: flex;
  align-items: center; justify-content: center; gap: 8px; font-size: 11px; font-weight: 800; white-space: nowrap;
}
.primary { color: #092016; background: var(--green); }
.primary:hover { background: #7af0bd; }
.stop { color: #ff9eaa; background: #45212c; border: 1px solid #743443; }
button:disabled { opacity: .45; cursor: not-allowed; }

.clear-button { background: #1b253b; border: 1px solid #2b3750; color: #aab7ce; padding: 8px; border-radius: 7px; }
.clear-button:hover { color: #ff7788; }

.incident-list { display: grid; }
.incident { display: flex; align-items: center; gap: 12px; padding: 13px 0; border-bottom: 1px solid #232d43; min-width: 0; }
.incident:last-child { border-bottom: 0; }
.incident-symbol { width: 32px; height: 32px; flex-shrink: 0; display: grid; place-items: center; border-radius: 8px; background: #382d1d; color: #f5c46e; }
.incident-symbol.alert { color: #ff8796; background: #3c222d; }
.incident-symbol.info { color: #80caff; background: #1d3041; }
.incident-text { flex: 1; min-width: 0; }
.incident-text b { display: block; font-size: 11px; line-height: 1.5; }
.incident-text small { display: block; margin-top: 4px; color: var(--muted); font-size: 10px; text-transform: capitalize; }
.incident time { color: var(--muted); font-size: 10px; white-space: nowrap; }

.empty-state { min-height: 130px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 9px; color: var(--green); text-align: center; }
.empty-state b { color: var(--text); font-size: 12px; }
.empty-state p { color: var(--muted); font-size: 11px; margin: 0; }
.view-all { display: block; margin: 13px auto 0; background: transparent; color: var(--green); border: 0; font-size: 11px; }

.hardware-list { display: grid; gap: 10px; margin-top: 20px; }
.hardware-row { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 9px; color: var(--green); }
.hardware-row b { color: var(--text); font-size: 12px; }
.hardware-row span { margin-left: auto; color: var(--muted); font-size: 10px; }

footer { display: flex; justify-content: space-between; gap: 12px; padding: 8px 2px; color: #71809c; font-size: 9px; }

@media (max-width: 1000px) {
  .sidebar { width: 205px; }
  .main { padding: 22px 18px; }
  .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 680px) {
  .app-shell { display: block; }
  .sidebar { width: 100%; padding: 14px; min-height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
  .brand { padding: 0 4px 15px; }
  .nav-heading, .sidebar-bottom { display: none; }
  .sidebar nav { display: flex; }
  .nav-button { flex: 1; justify-content: center; padding: 10px 5px; gap: 6px; }
  .main { padding: 19px 12px; }
  .topbar h1 { font-size: 20px; }
  .connection { font-size: 9px; }
  .avatar { width: 29px; height: 29px; }
  .metric { padding: 12px; }
  .metric h2 { font-size: 17px; }
  .panel { padding: 14px; }
  .camera-frame { height: 230px; }
  .controls { align-items: stretch; flex-direction: column; }
  .primary, .stop { width: 100%; }
  .incident { gap: 8px; }
  .incident-text b { font-size: 10px; }
  .incident time { font-size: 9px; }
  footer { flex-direction: column; line-height: 1.5; }
}

/* FairExam AI - functional controls and responsive panels */

.primary,
.stop,
.clear-button,
.icon-button,
.view-all,
.nav-button {
  font-family: inherit;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.primary,
.stop {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 18px;
  border: 1px solid #6578ff;
  border-radius: 10px;
  background: #5865f2;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
}

.primary:hover {
  background: #4654df;
}

.stop {
  border-color: #d95768;
  background: #a83248;
}

.stop:hover {
  background: #c23b52;
}

.primary:disabled,
.stop:disabled,
.clear-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.clear-button,
.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 10px 13px;
  border: 1px solid #33435f;
  border-radius: 9px;
  background: #19243a;
  color: #e8efff;
}

.clear-button:hover,
.icon-button:hover {
  background: #263653;
}

.icon-button {
  margin-left: 8px;
}

.nav-button {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
}

.nav-button span:nth-child(2) {
  flex: 1;
}

.hero-copy {
  margin-bottom: 22px;
}

.hero-copy h2 {
  margin: 10px 0;
  font-size: clamp(23px, 3vw, 34px);
}

.report-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin: 20px 0;
}

.camera-frame img {
  display: block;
  width: 100%;
  max-height: 520px;
  object-fit: contain;
  background: #080d19;
}

.camera-frame {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  background: #080d19;
}

.live-label {
  position: absolute;
  top: 12px;
  left: 12px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border-radius: 8px;
  background: #111b2ce8;
  color: white;
  font-size: 12px;
}

.controls,
.camera-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 18px;
}

.camera-info {
  color: #aabbd7;
  font-size: 13px;
}

.camera-info > span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.notice {
  margin: 16px 24px;
  padding: 12px 16px;
  border: 1px solid #455b88;
  border-radius: 10px;
  background: #172743;
  color: #edf3ff;
}

@media (max-width: 760px) {
  .report-summary {
    grid-template-columns: 1fr;
  }

  .controls {
    align-items: stretch;
  }

  .controls .primary,
  .controls .stop {
    width: 100%;
  }
}
